# Copie para .env na raiz. Estes valores servem apenas para desenvolvimento local.
# Não use esta senha em nenhum ambiente compartilhado ou de produção.
# Nunca coloque segredos em variáveis NEXT_PUBLIC_*.

DATABASE_URL=postgresql://verasjuris:verasjuris@127.0.0.1:5432/verasjuris
# Em produção (migrations / drizzle): use também DIRECT_URL apontando ao Postgres sem pooler, se aplicável.
# DIRECT_URL=postgresql://verasjuris:verasjuris@127.0.0.1:5432/verasjuris

API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
# Servidor Next → API (BFF /api/v1 e RSC). Nunca usar só NEXT_PUBLIC_* como hop principal.
# Local:
API_INTERNAL_URL=http://127.0.0.1:4000
# Produção (projeto Web na Vercel) — obrigatório:
# API_INTERNAL_URL=https://api.verasjuris.com
# Fallback HTTPS em produção se API_INTERNAL_URL ausente (também no projeto Web):
# NEXT_PUBLIC_API_URL=https://api.verasjuris.com
# Opcional no browser; preferir sempre o BFF /api/v1. Sem segredos.
# NEXT_PUBLIC_API_URL=

WORKER_HOST=127.0.0.1
WORKER_PORT=4001
# Produção (Vercel cron/HTTP): segredo para header x-worker-invoke-secret.
# WORKER_INVOKE_SECRET=

LOG_LEVEL=info
NODE_ENV=development

# Provider de e-mail: not_configured (padrão), memory (somente testes/dev; proibido em produção) ou resend.
EMAIL_PROVIDER=not_configured
# Produção Resend (nunca commitar valores reais):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=VerasJuris <noreply@seu-dominio.com>

# Object storage: not_configured (padrão), local (somente development/test) ou supabase.
# Em produção, local é recusado salvo ALLOW_LOCAL_STORAGE_IN_PRODUCTION=1 (desaconselhado).
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/private-storage
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=0
# Produção Supabase Storage (bucket privado; service role só no servidor):
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=VERASJURIS
DOCUMENT_MAX_UPLOAD_MB=10
MALWARE_SCANNER_PROVIDER=not_configured
TEMPORARY_URL_TTL_SECONDS=120
# Opcional. Se omitido em dev, a API deriva um segredo local não persistente.
# DOCUMENT_DOWNLOAD_TOKEN_SECRET=

# IA: padrão not_configured. openai exige FEATURE_AI=1 + OPENAI_API_KEY (servidor apenas).
AI_PROVIDER=not_configured
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT_MS=
AI_MAX_RETRIES=
AI_MAX_INPUT_TOKENS=
# Orçamento mensal em micros inteiros (1 unidade monetária = 1000000 micros).
AI_MONTHLY_BUDGET_MICROS=
# Produção OpenAI:
# AI_PROVIDER=openai
# FEATURE_AI=1
# OPENAI_API_KEY=
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# OPENAI_HEALTHCHECK=0
OCR_PROVIDER=not_configured
PUBLIC_OPPORTUNITY_PROVIDER=not_configured
AUCTION_PROVIDER=not_configured
LEGAL_SOURCE_PROVIDER=not_configured

# Funcionalidades dependentes de fornecedor. 0 = desligada.
FEATURE_AI=0
FEATURE_EXTERNAL_INTEGRATIONS=0

# Pagamentos / Asaas (servidor apenas — nunca NEXT_PUBLIC_*).
# Padrão: not_configured. Sandbox para testes; produção exige PAYMENTS_LIVE=1.
PAYMENT_PROVIDER=not_configured
BILLING_PROVIDER=not_configured
# ASAAS_ENVIRONMENT=sandbox
# ASAAS_API_KEY=
# ASAAS_API_URL=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_USER_AGENT=VerasJuris
# ASAAS_HEALTHCHECK=0
PAYMENTS_LIVE=0
FEATURE_PUBLIC_CHECKOUT=0
# Webhook receptor (após API pública): POST /v1/webhooks/payments/asaas
# Header obrigatório: asaas-access-token: <ASAAS_WEBHOOK_TOKEN>

# Opcional. Se preenchidos, `pnpm db:seed` cria um usuário de desenvolvimento.
# Deixe em branco para não criar conta local.
SEED_USER_NAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Organização interna VerasJuris Control (opcional). UUID da org com internal_company=true.
# Sem este valor, o gate ainda exige org.internalCompany === true.
# VERASJURIS_INTERNAL_ORGANIZATION_ID=
